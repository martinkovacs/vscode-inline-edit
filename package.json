{
  "name": "inline-edit",
  "displayName": "Inline Edit",
  "description": "Inline code editing powered by LLMs via OpenRouter",
  "version": "0.0.1",
  "publisher": "martinkovacs",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "inlineEdit.run",
        "title": "Inline Edit: Edit Selection with AI"
      },
      {
        "command": "inlineEdit.accept",
        "title": "Inline Edit: Accept Changes"
      },
      {
        "command": "inlineEdit.reject",
        "title": "Inline Edit: Reject Changes"
      },
      {
        "command": "inlineEdit.anthropicLogin",
        "title": "Inline Edit: Login with Claude (Anthropic OAuth)"
      },
      {
        "command": "inlineEdit.anthropicLogout",
        "title": "Inline Edit: Logout from Claude (Anthropic)"
      },
      {
        "command": "inlineEdit.chatgptLogin",
        "title": "Inline Edit: Login with ChatGPT"
      },
      {
        "command": "inlineEdit.chatgptLogout",
        "title": "Inline Edit: Logout from ChatGPT"
      }
    ],
    "keybindings": [
      {
        "command": "inlineEdit.run",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "inlineEdit.accept",
        "key": "enter",
        "when": "inlineEdit.diffVisible"
      },
      {
        "command": "inlineEdit.reject",
        "key": "escape",
        "when": "inlineEdit.diffVisible"
      }
    ],
    "configuration": {
      "title": "Inline Edit",
      "properties": {
        "inlineEdit.provider": {
          "type": "string",
          "enum": ["openrouter", "anthropic", "chatgpt"],
          "default": "openrouter",
          "description": "Which provider to use. 'openrouter' uses your OpenRouter API key, 'anthropic' calls the Anthropic API directly (API key or OAuth login), 'chatgpt' uses your ChatGPT Plus subscription via OAuth login."
        },
        "inlineEdit.openRouterApiKey": {
          "type": "string",
          "default": "",
          "description": "Your OpenRouter API key (only used when provider is 'openrouter')"
        },
        "inlineEdit.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "Your Anthropic API key (optional — you can also use OAuth login via the 'Login with Claude' command)"
        },
        "inlineEdit.model": {
          "type": "string",
          "default": "anthropic/claude-sonnet-4",
          "description": "Model to use. For OpenRouter: any model ID (e.g. anthropic/claude-sonnet-4, openai/gpt-4o). For Anthropic: a Claude model ID (e.g. claude-sonnet-4-20250514). ChatGPT always uses gpt-5."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
